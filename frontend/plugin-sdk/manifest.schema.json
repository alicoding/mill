{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mill://schema/plugin-manifest/v1",
  "$defs": {
    "CanvasObjectContribution": {
      "properties": {
        "kind": {
          "type": "string"
        },
        "fileExtensions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "pastesURLs": {
          "type": "boolean"
        },
        "entry": {
          "type": "string"
        },
        "tool": {
          "type": "boolean"
        },
        "example": {
          "$ref": "#/$defs/CanvasObjectExample"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "CanvasObjectExample": {
      "properties": {
        "title": {
          "type": "string"
        },
        "payload": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "revision": {
          "type": "integer"
        },
        "fixtures": {
          "items": {
            "$ref": "#/$defs/CanvasObjectExampleFixture"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "CanvasObjectExampleFixture": {
      "properties": {
        "kind": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "payloadKey": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "CaptureContribution": {
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "entry": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "CommandContribution": {
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "enablement": {
          "type": "string"
        },
        "menu": {
          "$ref": "#/$defs/CommandMenuContribution"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "CommandMenuContribution": {
      "properties": {
        "path": {
          "type": "string"
        },
        "group": {
          "type": "integer"
        },
        "order": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "DependencyContribution": {
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "MCPServerContribution": {
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "args": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ManifestContributes": {
      "properties": {
        "canvasObjects": {
          "items": {
            "$ref": "#/$defs/CanvasObjectContribution"
          },
          "type": "array"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/StepContribution"
          },
          "type": "array"
        },
        "captures": {
          "items": {
            "$ref": "#/$defs/CaptureContribution"
          },
          "type": "array"
        },
        "settings": {
          "items": {
            "$ref": "#/$defs/SettingContribution"
          },
          "type": "array"
        },
        "configuration": {
          "items": {
            "$ref": "#/$defs/SettingContribution"
          },
          "type": "array"
        },
        "menus": {
          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/MenuItemContribution"
            },
            "type": "array"
          },
          "type": "object"
        },
        "network": {
          "items": {
            "$ref": "#/$defs/NetworkContribution"
          },
          "type": "array"
        },
        "views": {
          "items": {
            "$ref": "#/$defs/ViewContribution"
          },
          "type": "array"
        },
        "commands": {
          "items": {
            "$ref": "#/$defs/CommandContribution"
          },
          "type": "array"
        },
        "themes": {
          "items": {
            "$ref": "#/$defs/ThemeContribution"
          },
          "type": "array"
        },
        "secretSources": {
          "items": {
            "$ref": "#/$defs/SecretSourceContribution"
          },
          "type": "array"
        },
        "tools": {
          "items": {
            "$ref": "#/$defs/ToolContribution"
          },
          "type": "array"
        },
        "mcpServers": {
          "items": {
            "$ref": "#/$defs/MCPServerContribution"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "MenuItemContribution": {
      "properties": {
        "command": {
          "type": "string"
        },
        "when": {
          "type": "string"
