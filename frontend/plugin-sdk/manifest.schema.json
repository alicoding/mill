  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "minMillVersion": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "capabilities": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "dependencies": {
      "items": {
        "$ref": "#/$defs/DependencyContribution"
      },
      "type": "array"
    },
    "exports": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "contributes": {
      "$ref": "#/$defs/ManifestContributes"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "id",
    "name",
    "version"
  ]
}
