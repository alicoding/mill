        "family": {
          "type": "string"
        },
        "file": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ToolContribution": {
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "inputSchema": true,
        "effect": {
          "type": "string"
        },
        "run": {
          "$ref": "#/$defs/ToolRun"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ToolRun": {
      "properties": {
        "kind": {
          "type": "string"
        },
        "commandId": {
          "type": "string"
        },
        "stepId": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ViewContribution": {
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "entry": {
          "type": "string"
        },
        "placement": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    }
