        "methods": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "SecretSourceContribution": {
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/SecretSourcePathContribution"
        },
        "capabilities": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "SecretSourcePathContribution": {
      "properties": {
        "kind": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "placeholder": {
          "type": "string"
        },
        "default": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "SettingContribution": {
      "properties": {
        "key": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "default": true,
        "options": {
          "items": {
            "$ref": "#/$defs/SettingOption"
          },
          "type": "array"
        },
        "min": {
          "type": "number"
