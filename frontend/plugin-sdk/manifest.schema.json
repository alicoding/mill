      "additionalProperties": false,
      "type": "object"
    },
    "StepConfigContribution": {
      "properties": {
        "key": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "default": {
          "type": "string"
        },
        "options": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "StepContribution": {
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
