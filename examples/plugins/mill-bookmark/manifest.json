{
  "id": "mill-bookmark",
  "name": "Bookmark",
  "version": "1.0.0",
  "description": "Keeps a web address on the board and opens it in your browser.",
  "author": "Mill examples",
  "minMillVersion": "0.9.0",
  "icon": "icon.png",
  "capabilities": [
    "open-url"
  ],
  "contributes": {
    "canvasObjects": [
      {
        "kind": "bookmark",
        "pastesURLs": true,
        "example": {
          "title": "Bookmark example",
          "payload": { "url": "https://example.com/board-gallery" },
          "revision": 1,
          "fixtures": []
        }
      }
    ],
    "settings": [
      {
        "key": "titleStyle",
        "type": "enum",
        "label": "Title",
        "description": "What a bookmark shows as its title.",
        "default": "hostname",
        "options": [
          {
            "value": "hostname",
            "label": "Site name"
          },
          {
            "value": "address",
            "label": "Full address"
          }
        ]
      },
      {
        "key": "placeholderTitle",
        "type": "string",
        "label": "Title before an address",
        "description": "Shown until you enter an address.",
        "default": "Bookmark"
      }
    ]
  }
}
