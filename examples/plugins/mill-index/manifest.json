{
  "id": "mill-index",
  "name": "Board index",
  "version": "1.0.0",
  "description": "Lists everything on the board by kind, and keeps the list current as the board changes.",
  "author": "Mill examples",
  "minMillVersion": "0.9.0",
  "icon": "icon.png",
  "capabilities": [],
  "contributes": {
    "canvasObjects": [
      {
        "kind": "index"
      }
    ],
    "views": [
      {
        "id": "contents",
        "title": "Board contents",
        "entry": "view.html"
      }
    ],
    "commands": [
      {
        "id": "mill-index.refresh",
        "label": "Refresh the board index",
        "menu": {
          "path": "help",
          "group": 1,
          "order": 2
        }
      }
    ],
    "tools": [
      {
        "name": "refresh_board_index",
        "description": "Lists the board again in every board index on the canvas.",
        "inputSchema": {
          "type": "object",
          "properties": {}
        },
        "effect": "read",
        "run": {
          "kind": "command",
          "commandId": "mill-index.refresh"
        }
      }
    ]
  }
}
