{
  "id": "mill-clipper",
  "name": "Web clipper",
  "version": "1.0.0",
  "description": "Clips a web page's article into a note, with its source address kept.",
  "author": "Mill examples",
  "minMillVersion": "0.14.1",
  "icon": "icon.png",
  "capabilities": [
    "fetch",
    "write-content"
  ],
  "contributes": {
    "canvasObjects": [
      {
        "kind": "clip",
        "pastesURLs": true
      }
    ],
    "network": [
      {
        "host": "*"
      }
    ]
  }
}
