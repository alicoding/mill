{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mill://schema/environment/v1",
  "$defs": {
    "Variable": {
      "properties": {
        "Key": {
          "type": "string"
        },
        "Value": {
          "type": "string"
        },
        "Secret": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "Key",
        "Value",
        "Secret"
      ]
    }
  },
  "properties": {
    "schema": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "vars": {
      "items": {
        "$ref": "#/$defs/Variable"
      },
      "type": "array"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schema",
    "label",
    "vars"
  ]
}
