{
  "id": "mill-drawing",
  "name": "Drawing",
  "version": "1.0.0",
  "description": "Freehand drawing tools for the board: pencil, shape, eraser, and laser pointer.",
  "author": "Mill",
  "minMillVersion": "0.14.1",
  "icon": "icon.png",
  "capabilities": [
    "erase-board-items"
  ],
  "contributes": {
    "canvasObjects": [
      {
        "kind": "pencil",
        "tool": true
      },
      {
        "kind": "shape",
        "tool": true
      },
      {
        "kind": "eraser",
        "tool": true
      },
      {
        "kind": "laser",
        "tool": true
      }
    ],
    "commands": [
      {
        "id": "mill-drawing.showTips",
        "label": "Drawing tips"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "mill-drawing.showTips",
          "when": "true"
        }
      ]
    }
  }
}
